<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Sound -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_sound_header"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:text="@string/settings_sound_label"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- Inspection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_inspection_header"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchInspection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:text="@string/settings_inspection_label"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- Display format -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_display_format_header"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgDisplayFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <RadioButton
                android:id="@+id/rbSeconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_format_seconds"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbMinSec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_format_minsec"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingsBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="@string/back_to_timer"
            android:textColor="@color/white" />

    </LinearLayout>

</ScrollView>
